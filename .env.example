# Kopieren nach .env und anpassen. Die .env wird nie committet.

# Zufälliger, langer Wert, z. B. erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Datenbank für den Betrieb
DATABASE_URL=postgresql+psycopg://localhost/steuy

# Datenbank für die Tests (wird bei jedem Testlauf geleert)
TEST_DATABASE_URL=postgresql+psycopg://localhost/steuy_test

# Ablage für unveränderliche Dateien (PDFs, Belege). Unbedingt mitsichern.
ABLAGE_VERZEICHNIS=instance/ablage

# Anzahl vorgeschalteter Reverse Proxys (z. B. 1 hinter Caddy oder nginx), sonst 0
PROXY_ANZAHL=0
