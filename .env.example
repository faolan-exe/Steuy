# Kopieren nach .env und anpassen. Die .env wird nie committet.

# Zufälliger, langer Wert, z. B. erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Datenbank für den Betrieb
DATABASE_URL=postgresql+psycopg://localhost/steuy

# Datenbank für die Tests (wird bei jedem Testlauf geleert)
TEST_DATABASE_URL=postgresql+psycopg://localhost/steuy_test

# Ablage für unveränderliche Dateien (PDFs, Belege). Unbedingt mitsichern.
ABLAGE_VERZEICHNIS=instance/ablage

# Anzahl vorgeschalteter Reverse Proxys (z. B. 1 hinter Caddy oder nginx), sonst 0
PROXY_ANZAHL=0

# Aus dem Internet ist steuy nur über https:// erreichbar, im eigenen Netz (private Adressen,
# VPN-Bereich 100.64.0.0/10) auch über http://. Weitere eigene Netze, durch Komma getrennt:
INTERNE_NETZE=
# Abschalten (nicht empfohlen): NUR_HTTPS_VON_AUSSEN=0

# Öffentliche Adresse für Links in E-Mails (Kundenportal), z. B. https://rechnung.meinefirma.de
# Mit https:// werden Cookies automatisch nur verschlüsselt übertragen.
BASIS_URL=

# Nach so vielen Stunden ohne Aktivität wird man abgemeldet (0 = nie)
LEERLAUF_STUNDEN=8

# E-Rechnung: Prüfung gegen die amtlichen Regeln in einem eigenen Prozess (spart ca. 200 MB
# Arbeitsspeicher je Worker). Auf Rechnern mit viel RAM geht „intern“ (Festschreiben schneller).
ERECHNUNG_PRUEFUNG=prozess
